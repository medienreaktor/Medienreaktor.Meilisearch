{
    "name": "medienreaktor/meilisearch",
    "type": "neos-package",
    "description": "Integrates Meilisearch into Neos.",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "neos/flow": "^8.3",
        "neos/neos": "^8.3",
        "neos/content-repository": "^8.3",
        "neos/content-repository-search": "^4.1.2",
        "neos/eel": "^8.3",
        "neos/media": "^8.3",
        "meilisearch/meilisearch-php": "^1.2",
        "guzzlehttp/guzzle": "^7.0",
        "http-interop/http-factory-guzzle": "^1.0"
    },
    "require-dev": {
        "kleisli/flow-phpstan": "^1.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Medienreaktor\\Meilisearch\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Medienreaktor\\Meilisearch\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": true
        }
    },
    "extra": {
        "neos": {
            "package-key": "Medienreaktor.Meilisearch"
        },
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "lint:composer": "@composer validate --strict --no-check-lock",
        "lint:phpstan": "@php vendor/bin/phpstan analyse",
        "lint:phpcs": "./vendor/bin/phpcs --colors",
        "lint:phpcs:fix": "./vendor/bin/phpcbf --colors",
        "lint": [
            "@lint:composer",
            "@lint:phpcs",
            "@lint:phpstan"
        ]
    }
}
