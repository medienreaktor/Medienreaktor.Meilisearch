includes:
    # Teaches PHPStan Flow's two magic APIs: FlowQuery operations and the
    # findBy<Property> finders on Repository. Deliberately extension.neon and not
    # the phpstan.neon beside it — that one is the package analysing itself, and
    # including it would override the level and paths set below.
    - Build/Kleisli.Flow.PhpStan/extension.neon

parameters:
    level: 5
    paths:
        - Classes
        - Tests
    # The package declares php ^8.0, so analyse against that floor rather than the
    # interpreter in use — otherwise 8.2-only syntax passes locally and breaks the
    # oldest supported target.
    phpVersion: 80000
