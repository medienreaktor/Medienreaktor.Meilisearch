includes:
    # Teaches PHPStan Flow's two magic APIs: FlowQuery operations and the
    # findBy<Property> finders on Repository. Deliberately extension.neon and not
    # the phpstan.neon beside it — that one is the package analysing itself, and
    # including it would override the level and paths set below.
    - Build/Kleisli.Flow.PhpStan/extension.neon

parameters:
    level: 5
    paths:
        - Classes
        - Tests
    # The second place the PHP floor is pinned, beside require.php ^8.1 in
    # composer.json; change both together. CI would not need it, since the lint
    # job runs on the floor. It is for local runs: the package is developed in
    # a project's DistributionPackages.local, inside that project's DDEV, on the
    # project's PHP - and must still be analysed against its own oldest target.
    phpVersion: 80100
