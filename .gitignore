.DS_Store
/.idea
/.vscode
/vendor/
# neos/composer-plugin installs neos-package dependencies here rather than into
# vendor/, so a standalone `composer install` creates this alongside vendor/.
/Packages/
# Packages of type neos-build — kleisli/flow-phpstan, for one — land here rather
# than in vendor/, for the same reason.
/Build/
/composer.lock
/.phpunit.cache/
/.phpunit.result.cache
